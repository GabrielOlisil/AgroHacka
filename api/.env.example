# ==============================================================================
# AGROHACK 2026/2 — API NESTJS (.env.example)
# ==============================================================================
# Copie este arquivo para .env na pasta api/:
# cp .env.example .env

# Porta da API
PORT=3000
NODE_ENV=development

# Conexão com o Banco PostgreSQL
# Para rodar com Docker local: postgresql://postgres:postgres@localhost:5432/agrohacka?schema=public
# Para apontar para a VPS em dev (se porta pública liberada): postgresql://user:pass@host:5432/db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrohacka?schema=public"

# Chave Secreta para Tokens JWT de Autenticação
JWT_SECRET="agrohack-jwt-secret-key-2026"

# Integração WhatsApp (Twilio) — Opcional
# As três variáveis são obrigatórias para envio real; se faltar qualquer uma,
# as notificações rodam no modo simulação (só aparecem no log).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Remetente: o número mostrado no Console da Twilio em Messaging → Try out WhatsApp
# (cada conta nova recebe o seu, por exemplo +17372508034).
TWILIO_PHONE=""
# Conta trial (Try out WhatsApp): a Twilio só aceita modelos prontos, não texto
# livre (erro "ContentSid Required"). Copie do trecho de código da página:
# o contentSid (HX...) e, se houver, as contentVariables em JSON.
# Vazio = envia o texto do alerta (Sandbox clássico ou conta paga).
TWILIO_CONTENT_SID=""
TWILIO_CONTENT_VARIABLES=""
# O WhatsApp que recebe os alertas é o do gestor, informado no cadastro ou no
# painel "Alertas de emergência via WhatsApp" do app (não é variável de ambiente).
# Celulares do Brasil: muitas contas do WhatsApp são identificadas sem o 9 depois
# do DDD (nono dígito). O número de teste verificado na Twilio e o salvo no app
# precisam estar no mesmo formato com que o WhatsApp identifica o celular.

# ==============================================================================
# API EM PRODUÇÃO NA NUVEM (Referência para o Frontend/DEV 2):
# URL Base: https://api.arikem.qzz.io
# Swagger:  https://api.arikem.qzz.io/api/docs
# ==============================================================================
