# ==============================================================================
# AGROHACK 2026/2 — DESKTOP (variáveis de ambiente)
# ==============================================================================
# O Vite carrega automaticamente o arquivo correto por ambiente:
#   .env.development  → usado em `npm run dev` / `tauri dev`
#   .env.production   → usado em `npm run build` / `tauri build` (embutido no binário)
#
# Copie este arquivo como ponto de partida:
#   cp .env.example .env.development    # e ajuste para dev local
#   cp .env.example .env.production     # e coloque a URL real

# URL base da API NestJS.
# Dev:       http://localhost:3000
# Produção:  https://api.arikem.qzz.io
VITE_API_URL=http://localhost:3000
